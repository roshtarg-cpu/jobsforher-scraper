{
  "schemaVersion": 1,
  "title": "JobsForHer Scraper Input",
  "type": "object",
  "properties": {
    "startUrl": {
      "title": "Start URL",
      "type": "string",
      "description": "URL to start scraping from",
      "default": "https://www.jobsforher.com/jobs",
      "prefill": "https://www.jobsforher.com/jobs",
      "editor": "textfield"
    },
    "maxResults": {
      "title": "Maximum Results",
      "type": "integer",
      "description": "Maximum number of job listings to scrape",
      "default": 50,
      "prefill": 10,
      "minimum": 1,
      "maximum": 10000,
      "editor": "number"
    },
    "proxyConfiguration": {
      "title": "Proxy Configuration",
      "type": "object",
      "description": "Proxy settings for the scraper",
      "prefill": {
        "useApifyProxy": true,
        "apifyProxyGroups": ["RESIDENTIAL"]
      },
      "editor": "proxy"
    }
  },
  "required": []
}
